ta": [{"type": "metadata", "contents": [{"content": "Written on the Body", "type": "lesson_name"}, {"content": "The Language of Gestures", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 2, "type": "lesson"}, {"content": "B2.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Understand actions, events, and experiences in present, past or future and in spoken or written texts and in work and social contexts.", "type": "primary"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_7"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"content": "engenn11le02ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Present Perfect Simple", "type": "heading"}, {"content": "You use the Present Perfect tense to talk about a past action or an action that began in the past that is connected to the present in some way. ", "type": "describer"}, {"content": "You can use the Present Perfect tense to talk about experience.<br/>When you use the Present Perfect tense, you think about the past and present together. There is some connection between what happened in the past and now. ", "type": "text"}, {"content": "For example: <br/><span class=\"italic\">Many people have experienced a language barrier in another country,  but what they don't realize is that others may not understand their gestures, either!</span><br/>  = the past event of experiencing a language barrier has an effect in the present, as seen in the second clause.", "type": "text"}, {"content": "You use the Present Perfect Simple to talk about habitual actions or with state verbs, when there is a connection to the present.", "type": "text"}, {"content": "Example: <br/><span class=\"italic\">I've lived here for the past ten years. </span><br/>= I still live here now.", "type": "text"}, {"content": "Many people have experienced a language barrier in another country.", "type": "example"}, {"content": "Have you ever given the \u201cokay\u201d symbol, for example?", "type": "example"}, {"content": "Those who have had to seek medical attention in a foreign country will know that clear communication is particularly important at the hospital.", "type": "example"}, {"content": "That's because very few cultures have developed a gesture for \u201cI'm sorry.\u201d ", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Purpose Clause ", "type": "heading"}, {"content": "You use purpose clauses to express the reasons for an action, or the intended motive of a specific situation.<br/>You use words like <span class=\"italic\">to</span>, <span class=\"italic\">in order to</span>, <span class=\"italic\">so as to</span> or <span class=\"italic\">for</span> + <span class=\"italic\">-ing</span> to introduce a purpose clause.", "type": "describer"}, {"content": "Purpose clauses are subordinate to the main clause. The order of the clauses can be interchangeable, as long as the relationship between the two remains clear.<br/>Example:<br/><span class=\"italic\">I have come up with a new plan <span class=\"strong\">in order to</span> stay focused.<br/><span class=\"strong\">In order to</span> stay focused, I have come up with a new plan.</span>", "type": "text"}, {"content": "You use <span class=\"italic\">to</span> with an infinitive as a way to express purpose. We refer to this structure as an Infinitive of purpose.<br/>Example: <br/><span class=\"italic\">I called <span class=\"strong\">to</span> find out if the order had been shipped.</span>", "type": "text"}, {"content": "You use <span class=\"italic\">in order to</span> or <span class=\"italic\">so as to</span> to emphasize an intention or a necessity.<br/>Example: <br/><span class=\"italic\">I would like to call for a meeting <span class=\"strong\">in order to / so as to</span> address the current issues in the restaurant.</span>", "type": "text"}, {"content": "You use <span class=\"italic\">in order that</span> or <span class=\"italic\">so that</span> when the second clause starts with a pronoun or a noun.<br/>Example: <br/><span class=\"italic\">You need to give me an answer, <span class=\"strong\">so that / in order that</span> I can address the problem quickly.</span>", "type": "text"}, {"content": "You also use <span class=\"italic\">for</span> + verb <span class=\"italic\">-ing</span> to express purpose and intended use.<br/>Example:<br/><span class=\"italic\">These boots are made <span class=\"strong\">for walking</span>.</span>", "type": "text"}, {"content": "In America and Britain, in order to show the number \"one\", a person would hold up his or her index finger.", "type": "example"}, {"content": "It's when you put your thumb and index finger together such that a circle is formed. ", "type": "example"}, {"content": "Some cultures do this so as to indicate that everything's fine and dandy. ", "type": "example"}, {"content": "The attending physician might press the affected area so that he or she can gauge your reaction.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "lip", "type": "name"}, {"content": "the area of skin that surrounds the opening of the mouth", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: She gave him a kiss right on the lips.", "type": "example"}, {"content": "engenn11le02ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about health and wellness.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "jaw", "type": "name"}, {"content": "the two bones around your mouth that hold your teeth in place", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: In some cultures, people point at things with a finger, and in others by sticking out their lips or jaw.", "type": "example"}, {"content": "engenn11le02ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "mix-up", "type": "name"}, {"content": "a misunderstanding", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Sometimes mix-ups can be very embarrassing.", "type": "example"}, {"content": "engenn11le02ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "seek medical attention", "type": "name"}, {"content": "to get help from a doctor or other medical professional", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Those who have had to seek medical attention in a foreign country will know that clear communication is particularly important at the hospital.", "type": "example"}, {"content": "engenn11le02ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "affected area", "type": "name"}, {"content": "the part of the body that has been injured", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The attending physician might press the affected area so that he or she can gauge your reaction.", "type": "example"}, {"content": "engenn11le02ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to gauge", "type": "name"}, {"content": "to measure; to calculate an amount", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Doctors need to gauge patient reactions.", "type": "example"}, {"content": "engenn11le02ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to wince", "type": "name"}, {"content": "to tighten your muscles in pain", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example:  Of course, if you wince or cry out in pain, the doctor should get the picture.", "type": "example"}, {"content": "engenn11le02ob01aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to cry out", "type": "name"}, {"content": "to scream or shout", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The child cried out in pain after falling from her bed.", "type": "example"}, {"content": "engenn11le02ob01aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "fine and dandy", "type": "name"}, {"content": "in good condition; okay", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Some cultures do this so as to indicate that everything's fine and dandy.", "type": "example"}, {"content": "engenn11le02ob01aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to get the picture", "type": "name"}, {"content": "to understand", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: He misunderstood at first, but after further explanation he got the picture.", "type": "example"}, {"content": "engenn11le02ob01aud10", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Go online and research gestures used in different cultures.", "type": "text"}, {"content": "On a blank piece of paper, try to draw a representation of each gesture.", "type": "text"}, {"content": "Beside each picture, write a short description of each gesture.", "type": "text"}, {"content": "Show your picture dictionary to a partner, and explain each gesture.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I research nonverbal communication.", "type": "text"}, {"content": "I write definitions.", "type": "text"}, {"content": "I display information in a picture dictionary.", "type": "text"}, {"content": "I explain gestures to a partner.", "type": "text"}]}], "type": "sena"}