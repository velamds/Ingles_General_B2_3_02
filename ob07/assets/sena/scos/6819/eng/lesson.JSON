: ""}}, {"content": "secondary_8", "type": "objective"}], "id": 0}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "For obvious reasons", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn11le02ob07re6aud06", "type": "audio"}]}, {"type": "post_question", "contents": {"content": ", small dogs are more suitable if you live in a small apartment.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 1}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "in that", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn11le02ob07re6aud07", "type": "audio"}, {"content": "Cats are better suited for independent people", "type": "text"}]}, {"type": "post_question", "contents": {"content": "they respect their need to be alone at times.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 2}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "inasmuch as", "type": "text"}], "selected": 0, "correct": 1}, {"text": "", "id": 2, "_data": [{"content": "because", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 3, "_data": [{"content": "For", "type": "text"}], "selected": 0, "correct": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn11le02ob07re6aud08", "type": "audio"}, {"content": "Portuguese water dogs are the perfect breed for people with allergies", "type": "text"}]}, {"type": "post_question", "contents": {"content": "their fur doesn't carry allergens.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 3}], "_data": [{"type": "instructions", "contents": [{"content": " Here are other reasons to get a pet.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Listen to the audio. Move the words from the box to correctly complete the sentences.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}]}], "id": 9, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn11le02ob07re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Report three health stories.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "video", "id": 2, "title": "", "contents": [{"type": "video", "value": {"video_src": "engenn11le02ob07re2vid01", "images": [{"image": "", "text": "Good evening, and welcome to the Fit Fifty, where we bring you fifty minutes of fitness news.\n<br/><br/>\nIn our top story tonight, a study has revealed that children who own pets have less stress. The research, which has included children from Australia to the UK, outlines the numerous benefits to pet ownership. First and foremost, pets encourage physical activity. Most of our viewers will not find this surprising, inasmuch as dogs require daily walks. Pets also act as a kind of live-in therapist, in that they provide comfort and increase self-esteem. Last but not least, our furry companions can help to reduce stress and anxiety, as they stimulate interaction and conversation.", "id": 0, "time": "1"}, {"image": "", "text": "Moving to the kitchen, a new study has shown that drinking beetroot juice reduces high blood pressure. The landmark study, which was headed by a pharmacologist from Queen Mary University, focused on patients with hypertension. One group of patients was given a daily glass of beetroot juice, while the control group was given a placebo. The results have clearly demonstrated that a significant reduction in blood pressure can result from just one glass of the juice per day. The effect is caused by inorganic nitrate, which is contained in beetroot and other leafy vegetables, and which causes blood vessels to relax and dilate. The results are excellent insofar as they suggest that a reduction in blood pressure is possible; however, for most hypertension sufferers, a complete change in diet will also be necessary.", "id": 1, "time": "51000"}, {"image": "", "text": "Our last story of the day involves another common beverage: water. For obvious reasons, water is an important part of a healthy lifestyle. Most people have slowly begun to realize this fact, and have increased daily water intake. Recent findings, however, suggest that many people may need to up their consumption even further. According to the Institute of Medicine, the suggested daily intake of water for men is three liters.\n<br/><br/>\nThat's all for this edition of the Fit Fifty. Remember folks, stay fit and have fun!", "id": 2, "time": "112000"}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Written on the Body", "type": "lesson_name"}, {"content": "A News Report", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 2, "type": "lesson"}, {"content": "B2.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe the reasons or results of events or actions in spoken or written texts, in work and social contexts.", "type": "primary"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_7"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"content": "engenn11le02ob07re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Present Perfect: Announcing News", "type": "heading"}, {"content": "You use the Present Perfect tense to announce past events that have current relevance.", "type": "describer"}, {"content": "When announcing news, the Present Perfect is used to focus on the new information.<br/>Examples:<br/><span class=\"italic\">They have updated their website.</span> (The website update is new information.) <br/><span class=\"italic\">They have just had a baby.</span> (They are just now telling people the news.) <br/><span class=\"italic\"> They have just called an election. </span>(We did not expect this to happen.)", "type": "text"}, {"content": "When using the Present Perfect Simple to talk about habitual actions or with state verbs, you often use a time marker such as <span class=\"italic\">for</span> or <span class=\"italic\">since</span>. <span class=\"italic\">For</span> is used to introduce the period of time the action has happened. <span class=\"italic\">Since</span> is used to mark the point in time when the action started.<br/>Example:<br/><span class=\"italic\">The fire has burned for hours!<br/></span><span class=\"italic\"> This has been the worst year for fires since 2014.</span>", "type": "text"}, {"content": "In our top story tonight, a study has revealed that children who own pets have less stress. ", "type": "example"}, {"content": "The research, which has included children from Australia to the UK, outlines the numerous benefits to pet ownership.", "type": "example"}, {"content": "Moving to the kitchen, a new study has shown that drinking beetroot juice reduces high blood pressure. ", "type": "example"}, {"content": "The results have clearly demonstrated that a significant reduction in blood pressure can result from just one glass of the juice per day.", "type": "example"}, {"content": "Most people have slowly begun to realize this fact, and have increased daily water intake.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Giving Reasons: <span class=\"italic\">For</span>, <span class=\"italic\">In that</span>, <span class=\"italic\">Insofar as</span>, <span class=\"italic\">Inasmuch as</span>", "type": "heading"}, {"content": "You use reason clauses to express the reasons for an action, or why a situation is the way it is.<br/>You use words like <span class=\"italic\">for</span>, <span class=\"italic\">in that</span>, <span class=\"italic\">insofar as</span>, or <span class=\"italic\">inasmuch as</span> to introduce a reason clause to give a reason for something.", "type": "describer"}, {"content": "Reason clauses are subordinate to the main clause. They state the reason why things are done, or what makes a situation the way it is.<br/>You can use <span class=\"italic\">for</span>, <span class=\"italic\">in that</span>, <span class=\"italic\">insofar as</span>, or <span class=\"italic\">inasmuch as</span> to introduce a reason clause to give a reason for something.", "type": "text"}, {"content": "<span class=\"italic\">For</span> has a meaning similar to <span class=\"italic\">because </span>in a reason clause.<br/>Example:<br/><span class=\"italic\">We must begin planning, <span class=\"strong\">for</span> the future may have some unexpected turns.</span>", "type": "text"}, {"content": "<span class=\"italic\">In that</span>, <span class=\"italic\">insofar as</span>, <span class=\"italic\">inasmuch as</span>, have similar meanings. You generally use these in formal written English rather than in spoken English. They introduce clauses that clarify what has been said by adding more detail and information.<br/>Example:<br/><span class=\"italic\">The film is unusual <span class=\"strong\">in that</span> it only features 2 actors.</span>", "type": "text"}, {"content": "Most of our viewers will not find this surprising, inasmuch as dogs require daily walks.", "type": "example"}, {"content": "Pets also act as a kind of live-in therapist, in that they provide comfort and self-esteem.", "type": "example"}, {"content": "The results are excellent insofar as they suggest that a reduction in blood pressure is possible; however, for most hypertension sufferers, a complete change in diet will also be necessary.", "type": "example"}, {"content": "For obvious reasons, water is an important part of a healthy lifestyle.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "therapist", "type": "name"}, {"content": "a person who treats psychological problems", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Pets also act as a kind of live-in therapist.", "type": "example"}, {"content": "engenn11le02ob07aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about health and wellness.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "self-esteem", "type": "name"}, {"content": "confidence in one's own abilities", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Pets provide comfort and increase self-esteem.", "type": "example"}, {"content": "engenn11le02ob07aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "pharmacologist", "type": "name"}, {"content": "a person who studies the effects of drugs on the body", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The landmark study, which was headed by a pharmacologist from Queen Mary University, focused on patients with hypertension.", "type": "example"}, {"content": "engenn11le02ob07aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "hypertension", "type": "name"}, {"content": "a medical condition in which a person's blood pressure is very high", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Because he suffered from hypertension, he had to alter his diet.", "type": "example"}, {"content": "engenn11le02ob07aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "placebo", "type": "name"}, {"content": "a medicine that has no effect which is given to patients as a control when testing new drugs", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: One group of patients was given a daily glass of beetroot juice, while the control group was given a placebo.", "type": "example"}, {"content": "engenn11le02ob07aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "blood vessel", "type": "name"}, {"content": "a tube in the body through which blood flows", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The effect is caused by inorganic nitrate, which is contained in beetroot and other leafy vegetables, and which causes blood vessels to relax and dilate.", "type": "example"}, {"content": "engenn11le02ob07aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to dilate", "type": "name"}, {"content": "to become wider or more open", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Once the blood vessels dilate, blood pressure decreases.", "type": "example"}, {"content": "engenn11le02ob07aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Go online and find three recent health-related stories.", "type": "text"}, {"content": "Make notes on the stories.", "type": "text"}, {"content": "Pretend that you are a newscaster, and present the three stories to your classmates.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I research health-related news.", "type": "text"}, {"content": "I make notes on health-related news.", "type": "text"}, {"content": "I present my notes to my classmates.", "type": "text"}]}]}